+/* Keep the grab target usable at fractional output scales. Only corners of
+ * the topmost floating client participate; ordinary content clicks pass through. */
+static int pointer_floating_corner(Client *c, double x, double y) {
+	if (!c || !c->isfloating || c->isfullscreen || c->ismaximizescreen ||
+		client_is_unmanaged(c) || !c->mon || c->mon->isoverview ||
+		server.session_locked || server.exclusive_focus || server.seat->drag)
+		return -1;
+
+	double cx = x - c->geom.x, cy = y - c->geom.y;
+	int width = c->geom.width, height = c->geom.height;
+	if (cx < 0 || cy < 0 || cx >= width || cy >= height)
+		return -1;
+	int grip = 12;
+	if ((cx >= grip && cx < width - grip) ||
+		(cy >= grip && cy < height - grip))
+		return -1;
+	return (cx >= width / 2.0 ? 1 : 0) + (cy >= height / 2.0 ? 2 : 0);
+}
