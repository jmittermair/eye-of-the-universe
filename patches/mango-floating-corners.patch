+/* Some X11 clients publish WM_CLASS after mapping. Apply the explicit floating
+ * preference then, without resetting tags, geometry, or other window rules. */
+static void handle_xwayland_surface_set_class(struct wl_listener *listener,
+											void *data) {
+	Client *c = wl_container_of(listener, c, set_class);
+	struct wlr_surface *surface = client_surface(c);
+	if (!surface || !surface->mapped || !c->mon || c->iskilling ||
+		client_is_unmanaged(c) || c->isfullscreen || c->ismaximizescreen)
+		return;
+	const char *appid = client_get_appid(c), *title = client_get_title(c);
+	int floating = -1;
+	for (uint32_t i = 0; i < config.window_rules_count; i++) {
+		const ConfigWinRule *r = &config.window_rules[i];
+		if (!r->is_once && r->isfloating >= 0 &&
+			is_window_rule_matches(r, appid, title))
+			floating = r->isfloating;
+	}
+	if (floating >= 0 && floating != c->isfloating)
+		client_set_floating(c, floating);
+}
